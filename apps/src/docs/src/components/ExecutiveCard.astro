---
/**
 * ExecutiveCard.astro
 * Dual-lens non-technical summary component for business & leadership readers.
 * Compliant with Astryx design tokens.
 */
interface Props {
  title: string;
  analogy: string;
  impact: string;
}

const { title, analogy, impact } = Astro.props;
---

<div class="executive-card">
  <div class="executive-header">
    <span class="executive-badge">30-SEC EXECUTIVE SUMMARY</span>
    <h3 class="executive-title">{title}</h3>
  </div>
  <div class="executive-body">
    <div class="executive-field">
      <span class="field-icon">💡</span>
      <div class="field-text">
        <strong>Plain-English Analogy:</strong>
        <p>{analogy}</p>
      </div>
    </div>
    <div class="executive-field">
      <span class="field-icon">🎯</span>
      <div class="field-text">
        <strong>Business & Safety Guarantee:</strong>
        <p>{impact}</p>
      </div>
    </div>
  </div>
</div>

<style>
  .executive-card {
    margin: 1.75rem 0;
    padding: 1.25rem 1.5rem;
    border-radius: var(--forge-radius, 8px);
    background: var(--forge-bg-card, #1c1c1c);
    border: 1px solid var(--forge-border, #282828);
    box-shadow: var(--forge-shadow-card, 0 4px 20px rgba(0, 0, 0, 0.2));
  }

  .executive-header {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: 1rem;
  }

  .executive-badge {
    display: inline-block;
    width: fit-content;
    padding: 2px 10px;
    border-radius: var(--forge-radius-full, 9999px);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    background: var(--forge-primary-bg, rgba(62, 207, 142, 0.12));
    color: var(--forge-primary, #3ecf8e);
    border: 1px solid var(--forge-border-medium, #383838);
    text-transform: uppercase;
  }

  .executive-title {
    margin: 0 !important;
    font-size: 1.15rem !important;
    font-weight: 600 !important;
    color: var(--forge-text-main, #ededed) !important;
    border: none !important;
    padding: 0 !important;
  }

  .executive-body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .executive-field {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .field-icon {
    font-size: 1.1rem;
    line-height: 1.4;
  }

  .field-text {
    flex: 1;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--forge-text-main, #ededed);
  }

  .field-text strong {
    color: var(--forge-text-main, #ededed);
    display: block;
    margin-bottom: 0.15rem;
  }

  .field-text p {
    margin: 0 !important;
    color: var(--forge-text-muted, #8a8a8a);
  }
</style>
