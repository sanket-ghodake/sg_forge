---
/**
 * @forge/docs - DocsHero.astro
 * Modern developer documentation hero with Astryx design tokens.
 * Dual-theme compliant, responsive down to 320px viewport.
 * @requirements [SR-DOC-001] [HLR-UI-401]
 */
---

<div class="docs-hero-container">
  <!-- Eyebrow Badge -->
  <div class="hero-eyebrow">
    <span class="badge-dot"></span>
    <span class="badge-text">SG Forge Living Documentation</span>
    <span class="badge-separator">•</span>
    <span class="badge-version">v2.0.0 LTS</span>
    <span class="badge-separator">•</span>
    <span class="badge-tag">100% Air-Gapped</span>
  </div>

  <!-- Main Headline -->
  <h1 class="hero-headline">
    Mission-Critical Architecture &amp; <span class="headline-gradient">Living Systems Traceability</span>
  </h1>

  <!-- Plain-English Subtitle for both Tech & Non-Tech Readers -->
  <p class="hero-subtitle">
    Enterprise micro-app platform engineered with dedicated per-app Turso database isolation, zero external cloud dependencies, and 100% mathematically verified code-to-requirement traceability.
  </p>

  <!-- Action CTAs -->
  <div class="hero-actions">
    <a href="/docs/architecture/topology/" class="astryx-btn btn-primary" data-astryx-tooltip="Inspect platform network topology and Caddy gateway routing">
      <span>Explore Architecture</span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
    <a href="/docs/architecture/sdk-architecture/" class="astryx-btn btn-secondary" data-astryx-tooltip="Explore @forge/sdk core abstractions, RFC 7807 problem details, and client bridge">
      <span>Developer SDK Reference</span>
    </a>
    <a href="/docs/traceability/matrix/" class="astryx-btn btn-outline" data-astryx-tooltip="View live AST-verified bidirectional requirement matrix (SR -> HLR -> LLR -> Code)">
      <span>Traceability Matrix</span>
    </a>
  </div>

  <!-- Verified Open-Source Tooling & Diagram Skills Strip (Embedded GitHub Repositories) -->
  <div class="hero-tooling-strip">
    <div class="tooling-strip-label">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="git-icon">
        <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
      </svg>
      <span>Open-Source Toolchains &amp; Diagram Skills:</span>
    </div>
    <div class="tooling-chips">
      <a href="https://github.com/withastro/starlight" target="_blank" rel="noopener noreferrer" class="tool-chip" data-astryx-tooltip="Astro Starlight Documentation Engine (GitHub: withastro/starlight)">
        <span class="chip-dot"></span>
        <span class="chip-text">Astro Starlight</span>
        <span class="chip-badge">Docs Engine ↗</span>
      </a>
      <a href="https://github.com/CloudCannon/pagefind" target="_blank" rel="noopener noreferrer" class="tool-chip" data-astryx-tooltip="Pagefind WASM: 100% Offline Search (GitHub: CloudCannon/pagefind)">
        <span class="chip-dot"></span>
        <span class="chip-text">Pagefind WASM</span>
        <span class="chip-badge">Offline Search ↗</span>
      </a>
      <a href="/docs/features/astryx-ui/" class="tool-chip" data-astryx-tooltip="Editorial Vector Diagram Pipeline (.agents/skills/diagram-design/) with Astryx Tokens">
        <span class="chip-dot"></span>
        <span class="chip-text">diagram-design</span>
        <span class="chip-badge">Vector Skill</span>
      </a>
      <a href="https://github.com/safwansamsudeen/graphify" target="_blank" rel="noopener noreferrer" class="tool-chip" data-astryx-tooltip="Graphify Knowledge Graph & AST Code Analysis (GitHub: safwansamsudeen/graphify)">
        <span class="chip-dot"></span>
        <span class="chip-text">Graphify</span>
        <span class="chip-badge">AST Graph ↗</span>
      </a>
      <a href="/docs/architecture/database/" class="tool-chip" data-astryx-tooltip="Dedicated Turso (libSQL) database per micro-app with zero cross-tenant contamination">
        <span class="chip-dot"></span>
        <span class="chip-text">Turso DB</span>
        <span class="chip-badge">Dedicated Instance / App</span>
      </a>
    </div>
  </div>
</div>

<style>
  .docs-hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 3rem 1rem 2rem 1rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    border-radius: var(--forge-radius-full, 9999px);
    background: var(--forge-primary-bg, rgba(62, 207, 142, 0.12));
    border: 1px solid var(--forge-border-medium, rgba(62, 207, 142, 0.25));
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--forge-text-main, #ededed);
    margin-bottom: 1.5rem;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--forge-primary, #3ecf8e);
    box-shadow: 0 0 8px var(--forge-primary, #3ecf8e);
  }

  .badge-separator {
    opacity: 0.4;
    color: var(--forge-text-muted, #8a8a8a);
  }

  .badge-version {
    color: var(--forge-primary, #3ecf8e);
    font-weight: 700;
  }

  .badge-tag {
    color: var(--forge-text-muted, #8a8a8a);
  }

  .hero-headline {
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.035em;
    color: var(--forge-text-main, #ededed);
    margin: 0 0 1.25rem 0;
  }

  .headline-gradient {
    background: var(--forge-primary-gradient, linear-gradient(135deg, #3ecf8e 0%, #24b47e 100%));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtitle {
    font-size: clamp(1rem, 2vw, 1.15rem);
    line-height: 1.6;
    color: var(--forge-text-muted, #8a8a8a);
    max-width: 740px;
    margin: 0 0 2rem 0;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    margin-bottom: 2rem;
  }

  .btn-primary,
  .btn-primary:link,
  .btn-primary:visited {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.4rem;
    background: var(--forge-primary, #3ecf8e);
    color: var(--forge-primary-btn-text, #121212) !important;
    font-weight: 600;
    font-size: 0.92rem;
    border-radius: var(--forge-radius, 8px);
    text-decoration: none !important;
    transition: var(--forge-transition, all 0.15s ease);
    box-shadow: 0 2px 10px rgba(62, 207, 142, 0.25);
    border: 1px solid transparent;
  }

  .btn-primary:hover,
  .btn-primary:active {
    background: var(--forge-primary-hover, #34b27b);
    color: var(--forge-primary-btn-text, #121212) !important;
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(62, 207, 142, 0.35);
  }

  .btn-primary * {
    color: inherit !important;
  }

  .btn-secondary,
  .btn-secondary:link,
  .btn-secondary:visited {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.4rem;
    background: var(--forge-bg-card, #1c1c1c);
    color: var(--forge-text-main, #ededed) !important;
    font-weight: 600;
    font-size: 0.92rem;
    border: 1px solid var(--forge-border, #282828);
    border-radius: var(--forge-radius, 8px);
    text-decoration: none !important;
    transition: var(--forge-transition, all 0.15s ease);
  }

  .btn-secondary:hover,
  .btn-secondary:active {
    border-color: var(--forge-border-hover, #383838);
    background: var(--forge-bg-card-hover, #232323);
    color: var(--forge-primary, #3ecf8e) !important;
    transform: translateY(-1px);
  }

  .btn-secondary * {
    color: inherit !important;
  }

  .btn-outline,
  .btn-outline:link,
  .btn-outline:visited {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.4rem;
    background: transparent;
    color: var(--forge-text-muted, #8a8a8a) !important;
    font-weight: 500;
    font-size: 0.92rem;
    border: 1px dashed var(--forge-border, #282828);
    border-radius: var(--forge-radius, 8px);
    text-decoration: none !important;
    transition: var(--forge-transition, all 0.15s ease);
  }

  .btn-outline:hover,
  .btn-outline:active {
    color: var(--forge-text-main, #ededed) !important;
    border-color: var(--forge-primary, #3ecf8e);
    transform: translateY(-1px);
  }

  .btn-outline * {
    color: inherit !important;
  }

  /* Open-Source Tooling & Skills Strip */
  .hero-tooling-strip {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    margin-top: 0.5rem;
  }

  .tooling-strip-label {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--forge-text-muted, #8a8a8a);
    letter-spacing: 0.02em;
  }

  .git-icon {
    opacity: 0.75;
    color: var(--forge-text-muted, #8a8a8a);
  }

  .tooling-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    width: 100%;
  }

  .tool-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.75rem;
    background: var(--forge-bg-surface, #171717);
    border: 1px solid var(--forge-border, #282828);
    border-radius: var(--forge-radius-full, 9999px);
    font-size: 0.78rem;
    text-decoration: none !important;
    transition: var(--forge-transition, all 0.15s ease);
    color: var(--forge-text-main, #ededed) !important;
  }

  .tool-chip:link,
  .tool-chip:visited {
    color: var(--forge-text-main, #ededed) !important;
  }

  .tool-chip:hover {
    border-color: var(--forge-primary, #3ecf8e);
    background: var(--forge-bg-card-hover, #232323);
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  .tool-chip * {
    color: inherit !important;
  }

  .chip-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--forge-primary, #3ecf8e);
    box-shadow: 0 0 6px var(--forge-primary, #3ecf8e);
  }

  .chip-text {
    font-weight: 600;
    color: var(--forge-text-main, #ededed);
  }

  .chip-badge {
    font-size: 0.7rem;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    background: var(--forge-bg-card, #1c1c1c);
    border: 1px solid var(--forge-border-medium, #383838);
    color: var(--forge-text-muted, #8a8a8a);
    font-weight: 500;
  }

  @media (max-width: 640px) {
    .docs-hero-container {
      padding: 2rem 0.5rem 1.5rem 0.5rem;
    }
    .hero-actions {
      flex-direction: column;
      width: 100%;
    }
    .btn-primary, .btn-secondary, .btn-outline {
      width: 100%;
      justify-content: center;
    }
    .tool-chip {
      flex: 1 1 45%;
      justify-content: center;
    }
  }
</style>
