#!/usr/bin/env bash
# ==============================================================================
# SG Forge - Git Pre-Commit AI Agent Quality Gate & Logger Hook
# Enforces quality checks, logs commit intent, and stages all artifacts BEFORE commit.
# ZERO files are generated after commit.
# ==============================================================================
set -e

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

echo "⚡ [Git Pre-Commit Hook] Running SG Forge Quality Gate (29 Checks)..."

# Determine bun runtime
BUN_BIN="bun"
if [ -f "$REPO_ROOT/portables/bun/bin/bun" ]; then
    BUN_BIN="$REPO_ROOT/portables/bun/bin/bun"
fi

# Run pre-commit quality gate. Exit with non-zero on failure to strictly block git commit.
if ! "$BUN_BIN" run "$REPO_ROOT/scripts/verify-gate.ts"; then
    echo "❌ [PRE-COMMIT GATE FAILED] Git commit aborted. Fix all errors above before committing."
    exit 1
fi

echo "📝 [Git Pre-Commit Hook] Recording pre-commit log entries..."
"$BUN_BIN" run "$REPO_ROOT/scripts/log-commit.ts" --precommit 2>/dev/null || true

# Automatically stage ALL generated logs, audit ledgers, reports, SBOM, and graphify artifacts BEFORE commit completes
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git add "$REPO_ROOT/logs" \
            "$REPO_ROOT/logs/security" \
            "$REPO_ROOT/apps/src/docs/security/sbom" \
            "$REPO_ROOT/apps/src/docs/traceability" \
            "$REPO_ROOT/docs/security/sbom" \
            "$REPO_ROOT/docs/traceability" \
            "$REPO_ROOT/graphify-out" \
            "$REPO_ROOT/.agents/reports" 2>/dev/null || true
fi
