#!/usr/bin/env bash
# ==============================================================================
# SG Forge - Git Pre-Commit AI Agent Quality Gate & Logger Hook
# Enforces quality checks, logs commit intent, and stages all artifacts BEFORE commit.
# ZERO files are generated after commit.
# ==============================================================================
set -e

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

echo "⚡ [Git Pre-Commit Hook] Running SG Forge Quality Gate (29 Checks)..."

# Determine bun runtime
BUN_BIN="bun"
if [ -f "$REPO_ROOT/portables/bun/bin/bun" ]; then
    BUN_BIN="$REPO_ROOT/portables/bun/bin/bun"
fi

# ==============================================================================
# Self-Healing Pre-Flight Reconciliation
# Automatically reconciles ignore files, multi-agent directives, submodules,
# and declarative proxy definitions before running quality checks.
# ==============================================================================
echo "🔄 [Git Pre-Commit Hook] Running automated pre-flight reconciliation..."
"$BUN_BIN" run "$REPO_ROOT/scripts/sync-ignores.ts" 2>/dev/null || true
"$BUN_BIN" run "$REPO_ROOT/scripts/sync-directives.ts" 2>/dev/null || true
"$BUN_BIN" run "$REPO_ROOT/scripts/sync-submodules.ts" 2>/dev/null || true
"$BUN_BIN" run "$REPO_ROOT/scripts/generate-proxy.ts" 2>/dev/null || true

# Auto-stage self-healed files before running gates
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git add "$REPO_ROOT/.gitignore" \
            "$REPO_ROOT/.dockerignore" \
            "$REPO_ROOT/.antigravityignore" \
            "$REPO_ROOT/.cursorignore" \
            "$REPO_ROOT/.copilotignore" \
            "$REPO_ROOT/.graphifyignore" \
            "$REPO_ROOT/.graftignore" \
            "$REPO_ROOT/.repomixignore" \
            "$REPO_ROOT/.gitattributes" \
            "$REPO_ROOT/proxy/Caddyfile" 2>/dev/null || true
fi

# Run pre-commit quality gate. Exit with non-zero on failure to strictly block git commit.
if ! "$BUN_BIN" run "$REPO_ROOT/scripts/verify-gate.ts"; then
    echo "❌ [PRE-COMMIT GATE FAILED] Git commit aborted. Fix all errors above before committing."
    exit 1
fi

echo "📝 [Git Pre-Commit Hook] Recording pre-commit log entries..."
"$BUN_BIN" run "$REPO_ROOT/scripts/log-commit.ts" --precommit 2>/dev/null || true

# Automatically stage ALL generated logs, audit ledgers, reports, SBOM, and traceability artifacts BEFORE commit completes
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    for target in "$REPO_ROOT/logs" \
                  "$REPO_ROOT/apps/src/docs/security/sbom" \
                  "$REPO_ROOT/apps/src/docs/traceability" \
                  "$REPO_ROOT/graphify-out" \
                  "$REPO_ROOT/CLAUDE.md" \
                  "$REPO_ROOT/GEMINI.md" \
                  "$REPO_ROOT/.cursorrules" \
                  "$REPO_ROOT/.cursor" \
                  "$REPO_ROOT/.github/copilot-instructions.md" \
                  "$REPO_ROOT/.agents/AGENTS.md"; do
        if [ -e "$target" ]; then
            git add "$target" 2>/dev/null || true
        fi
    done
fi
