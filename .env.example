# ==============================================================================
# Forge Platform - Environment Configuration Template (2026 LTS)
# Single Source of Truth for Dynamic Ingress, Docker Stacks & White-Labeling
# ==============================================================================

# Core Project & Stack Root Identity (Single Namespace Parameter)
# All Docker compose stacks, container names, networks, and persistent volume
# namespaces automatically derive from this root parameter.
PROJECT_NAME="forge"

# Optional Overrides (Defaults derive automatically from PROJECT_NAME if omitted)
# COMPOSE_PROJECT_NAME="forge"
# CONTAINER_PREFIX="forge"
# DOCKER_NETWORK="forge_net"
# FORGE_APPS_NETWORK="forge_apps_net"

# Environment Modes:
# - APP_ENV: Protects CLI operations and safeguards against accidental DB wipes (run.sh)
# - NODE_ENV: Application runtime performance, caching, and security enforcement
APP_ENV="development"
NODE_ENV="development"

# Ingress Ports (Reverse Proxy Gateway)
# Development defaults to 8080 / 8443 so Port 80 / 443 remains free for Production
HTTP_PORT="8080"
HTTPS_PORT="8443"
PROD_HTTP_PORT="80"
PROD_HTTPS_PORT="443"

# Ingress Protocol Control:
# - Default: Both enabled (dual-stack HTTP & HTTPS)
# - To run HTTPS-only (block port 80/8080): set ENABLE_HTTP="false"
# - To run HTTP-only (block port 443/8443): set ENABLE_HTTPS="false"
ENABLE_HTTP="true"
ENABLE_HTTPS="false"
TLS_CERT_PATH="/etc/caddy/certs/cert.pem"
TLS_KEY_PATH="/etc/caddy/certs/key.pem"

# Internal Base Ports (Used by standalone services and mapped to APP_* entries below)
LANDING_PORT="3000"
PORTAL_PORT="3001"
DEV_DASHBOARD_PORT="3002"
DEV_HUB_PORT="3003"
AUTH_PORT="3004"
DOCS_PORT="3005"

# ==============================================================================
# 🧩 SINGLE-LOCATION DECLARATIVE SERVICE & APP REGISTRY (2026 LTS)
# All platform services, micro-apps, host processes, and cloud endpoints are
# declared in strictly one place (.env). Caddy, Portal, and DevCenter auto-sync.
#
# Syntax: APP_<SLUG>="<Name>|<Port>|<Path>|<Category>|<Role>|[Upstream Target Override]"
#
# Field Breakdown:
#   1. <Name>:     Display title in Portal cards and navigation (e.g. "Live Telemetry")
#   2. <Port>:     Internal TCP port the service listens on (e.g. 8087, 8089, 443)
#   3. <Path>:     Public URL path intercepted by Caddy (e.g. /portal, /apps/telemetry)
#   4. <Category>: Workspace grouping tab (e.g. "Developer Tools", "Micro-Apps")
#   5. <Role>:     RBAC clearance (e.g. "Public Ingress", "Employee / Admin", "Developer")
#   6. [Upstream]: Upstream destination host, container alias, or full URL (see below)
#
# Supported Deployment Topologies (Field 6):
#   - Scenario 1 (In-Repo Docker Submodule):
#       APP_TELEMETRY="Live Telemetry|8087|/apps/telemetry|Micro-Apps|Public|app-telemetry"
#   - Scenario 2 (External App / Decoupled Directory in Docker):
#       APP_EXTERNAL_SERVICE="External Hub|8089|/apps/external|Developer Tools|Employee / Admin|app-external"
#   - Scenario 3 (Native Host OS Process - Bun / Node / Python / Go):
#       APP_NATIVE_TOOL="Host Tool|5000|/apps/tool|Developer Tools|Developer|host.docker.internal"
#   - Scenario 4 (External SaaS / Cloud HTTPS Microservice):
#       APP_CRM="Corporate CRM|443|/apps/crm|Enterprise|Employee / Admin|https://crm.corp.internal"
#   - Scenario 5 (Multi-Machine Cluster / LAN Server):
#       APP_GPU="GPU Worker|9090|/apps/gpu|AI Grid|Public / Engineering|http://192.168.1.50:9090"
#   - Scenario 6 (Custom Root Ingress / Landing Page Options):
#       a) Built-in Hub:   APP_LANDING="Platform Hub (Landing)|3000|/|Platform Services|Public Ingress|landing"
#       b) External Site:  APP_LANDING="Corporate Site|443|/|Corporate|Public Ingress|https://marketing.acme.corp"
#       c) Direct Portal:  Omit APP_LANDING (or set DISABLE_LANDING="true") to redirect '/' to '/portal'
#   - Scenario 7 (WebSockets & Cloud IDEs):
#       APP_CODE="Cloud VS Code|8088|/apps/code|Developer Tools|Employee / Admin|app-code"
#   - Scenario 8 (Temporarily Disable App):
#       Prefix line with '#' (e.g. # APP_BETA="...") or set status='disabled' in platform_core.db
#
# After modifying APP_* entries, run: 'rtk ./run.sh sync-proxy'
# ==============================================================================
APP_LANDING="Platform Hub (Landing)|3000|/|Platform Services|Public Ingress|landing"
APP_PORTAL="Main Workspace & Org Canvas|3001|/portal|Core Enterprise Services|Employee / Admin"
APP_DEVCENTER="Developer Dashboard|3002|/devcenter|Core Enterprise Services|Developer"
APP_GATEWAY="Developer Hub & SDK Playground|3003|/gateway|Core Enterprise Services|Developer"
APP_AUTH="Central Identity & Auth|3004|/auth|Core Enterprise Services|Public / OAuth"
APP_DOCS="Forge Engineering & Architecture Portal|3005|/docs|Core Enterprise Services|Public / Developer"
APP_TELEMETRY="Live Telemetry Dashboard|8087|/apps/telemetry|Isolated Polyglot Forge Micro-Apps|Public / Engineering"
APP_CODE="Cloud VS Code|8088|/apps/code|Developer Tools|Employee / Admin|app-code"
# APP_GOALS="Individual Goal Center|8090|/apps/goals|Performance & Growth|Manager / Admin|app-goals"


# Authentication & ASVS 5.0 Zero-Trust Security
# NOTICE: In production (NODE_ENV=production), JWT_SECRET must be set to an external 32+ char key without 'dev-portable'
# Generate secure key via: openssl rand -hex 32
JWT_SECRET="dev-portable-secret-key-that-is-at-least-32-characters-long"
# Token Lifetimes & Security Guardrail Ceilings (Enforced in @forge/auth)
# - Access Token: Clamped between 60s (1m floor) and 1800s (30m ceiling). Default: 900s (15m)
JWT_ACCESS_TOKEN_EXPIRY_SECONDS="900"
# - Refresh Token (Sliding Inactivity Window): Clamped between 300s (5m floor) and 604800s (7d ceiling). Default: 604800s
JWT_REFRESH_TOKEN_EXPIRY_SECONDS="604800"
# - Absolute Session Lifetime (Hard Cap on Family): Clamped between 3600s (1h floor) and 604800s (7d ceiling). Default: 86400s (24h)
AUTH_ABSOLUTE_SESSION_MAX_SECONDS="86400"
SESSION_COOKIE_NAME="forge_session"

# Developer Dashboard Authentication
# In production, operator password must be >= 12 chars and cannot contain 'change-me' or 'dev-operator'
DEV_DASHBOARD_PASSWORD="dev-operator-secure-password-change-me"

# Enterprise Identity & Domain Scoping
AUTH_ORG_DOMAIN="forge.internal"
PUBLIC_DOMAIN="app.forge.internal"
SUPPORT_EMAIL="support@forge.internal"

# Canonical Data Directory Override (Optional)
# Leave empty to default to container standard mount (/app/data) or repository root (./apps/data)
FORGE_DATA_DIR=""

# Production Database Backup Engine (Optional)
# Set DB_BACKUP_DIR to custom OS path (e.g. /var/backups/forge) or leave empty for ./backups/db
DB_BACKUP_DIR=""
DB_BACKUP_INTERVAL_MINUTES="60"
DB_BACKUP_RETENTION_HOURS="168"
DB_BACKUP_ENCRYPT="false"
DB_BACKUP_ENCRYPTION_KEY=""

# Application-Level Runtime Field Encryption (AES-256-GCM)
# Generate via: openssl rand -hex 32
DATA_ENCRYPTION_KEY="dev-portable-data-encryption-key-must-be-32-chars-minimum!"
BLIND_INDEX_SALT="dev-portable-blind-index-salt-32-chars-minimum!"

# ==============================================================================
# 🏢 Branding, Identity & Dynamic White-Labeling (Public)
# Documentation Guide: http://localhost/docs/operations/branding-and-logos
# Physical Assets Root: public/brand/ (see public/brand/README.md)
# ==============================================================================
NEXT_PUBLIC_BRAND_NAME="Forge Platform"
NEXT_PUBLIC_ORG_NAME="Forge Platform"
NEXT_PUBLIC_BRAND_SHORT="FORGE"
NEXT_PUBLIC_BRAND_TAGLINE="Modular Corporate Portal & Sandboxing Engine"

# 🖼️ Brand Logo Asset Configuration:
# - Supported Formats: SVG (recommended for crisp vector scaling & dual-theme), PNG, WebP, AVIF, JPG, ICO.
# - Supported Value Types:
#   * Default static asset: "/brand/logo.png" or "/brand/logo.svg"
#   * Git-ignored custom override: "/brand/custom-logo.svg", "/brand/custom-logo.png", "/brand/custom/logo.svg"
#   * External CDN URL: "https://cdn.example.com/assets/logo.svg"
#   * Data URI: "data:image/svg+xml;base64,..."
#
# 🛡️ ZERO GIT DIRTY POLICY (Choose Any 1 of 3 Clean Workflows):
#   Approach 1 (Drop-in file override - Zero config change, Zero Git drift):
#     Simply drop your custom logo file into public/brand/ as 'custom-logo.svg' (or .png, .webp)
#     or inside 'public/brand/custom/logo.svg'. These patterns are globally git-ignored.
#     The Caddy gateway and @forge/sdk automatically prioritize and serve it with 0 git status changes.
#   Approach 2 (Git-ignored .env pointer):
#     Set NEXT_PUBLIC_BRAND_LOGO_URL below to your file path or external CDN URL.
#     Because .env is in .gitignore, git status remains 100% clean.
#   Approach 3 (In-place file editing with skip-worktree):
#     Run 'rtk ./run.sh lock-logo' then replace public/brand/logo.png or logo.svg directly.
#     Check status with 'rtk ./run.sh logo-status' or revert with 'rtk ./run.sh unlock-logo'.
NEXT_PUBLIC_BRAND_LOGO_URL="/brand/logo.png"

# 🌐 Favicon & Browser Tab Shortcut Icon:
# - Supported Formats: .ico, .svg, .png
NEXT_PUBLIC_BRAND_FAVICON_URL="/favicon.ico"

