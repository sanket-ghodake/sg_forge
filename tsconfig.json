{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@forge/sdk": ["apps/src/sdk/src/index.ts"],
      "@forge/sdk/*": ["apps/src/sdk/src/*"],
      "@forge/ui": ["apps/src/ui/src/index.ts"],
      "@forge/ui/*": ["apps/src/ui/src/*"],
      "@forge/types": ["apps/src/types/src/index.ts"],
      "@forge/types/*": ["apps/src/types/src/*"],
      "@forge/auth": ["apps/src/auth/src/index.ts"],
      "@forge/auth/*": ["apps/src/auth/src/*"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "forge-apps/**/*.ts",
    "forge-apps/**/*.tsx",
    "scripts/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", ".next"]
}
