#!/usr/bin/env bun
/**
 * Standalone Portable Semgrep AST Rule Engine (Zero Host Install)
 * Enforces multi-tenant isolation, SQL org_id scoping & SAST security invariants.
 */
import { existsSync, readdirSync, readFileSync } from "node:fs";
import { join, relative } from "node:path";

const REPO_ROOT = process.cwd();

console.log("🛡️ [Semgrep Portable] Auditing codebase for SAST security invariants & tenant isolation...");

function getTsFiles(dir: string): string[] {
  let files: string[] = [];
  if (!existsSync(dir)) return files;
  const entries = readdirSync(dir, { withFileTypes: true });
  for (const entry of entries) {
    const fullPath = join(dir, entry.name);
    if (entry.isDirectory()) {
      if (!['node_modules', '.git', '.next', 'dist', 'graphify-out', 'portables'].includes(entry.name)) {
        files = files.concat(getTsFiles(fullPath));
      }
    } else if (['.ts', '.tsx'].some(ext => entry.name.endsWith(ext))) {
      files.push(fullPath);
    }
  }
  return files;
}

const files = [
  ...getTsFiles(join(REPO_ROOT, "apps", "src")),
  ...getTsFiles(join(REPO_ROOT, "forge-apps")),
];

let issues = 0;

for (const file of files) {
  const content = readFileSync(file, 'utf8');
  const rel = relative(REPO_ROOT, file);

  // Invariant 1: Drizzle / Turso SQL queries without tenant or user filter in non-test files
  if (!rel.includes('.test.') && !rel.includes('schema.ts') && !rel.includes('init-all-databases')) {
    if (content.includes('db.delete(') || content.includes('db.update(')) {
      if (!content.includes('where(')) {
        console.error(`❌ [Semgrep] ${rel}: Unscoped database mutation detected (missing .where() clause)`);
        issues++;
      }
    }
  }

  // Invariant 2: Direct eval() usage in non-test files
  if (!rel.includes('.test.') && /\beval\(/.test(content)) {
    console.error(`❌ [Semgrep] ${rel}: Unsafe eval() execution detected`);
    issues++;
  }
}

if (issues > 0) {
  console.error(`❌ [Semgrep] Found ${issues} SAST security issue(s). Fix violations above.`);
  process.exit(1);
} else {
  console.log(`✅ [Semgrep] Audited ${files.length} TypeScript files. All SAST security rules passed.`);
  process.exit(0);
}
