#!/usr/bin/env bash
# ==============================================================================
# Standalone Portable Wrapper for Council of AI (Multi-Agent Decision Framework)
# Based on framework by Marius Silo (Silotech.xyz)
# Zero Host Modification - Enterprise Clean Architecture (2026 LTS)
# ==============================================================================
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

PORTABLE_BUN="$WORKSPACE_ROOT/portables/bun/bin/bun"
COUNCIL_RUNNER="$WORKSPACE_ROOT/scripts/council-runner.ts"

if [ -f "$COUNCIL_RUNNER" ]; then
    if [ -x "$PORTABLE_BUN" ]; then
        exec "$PORTABLE_BUN" run "$COUNCIL_RUNNER" "$@"
    elif command -v bun >/dev/null 2>&1; then
        exec bun run "$COUNCIL_RUNNER" "$@"
    elif command -v npx >/dev/null 2>&1; then
        exec npx --yes tsx "$COUNCIL_RUNNER" "$@"
    fi
fi

echo "❌ [council] Unable to resolve runtime or script: $COUNCIL_RUNNER" >&2
exit 1
