#!/usr/bin/env bash
# ==============================================================================
# Standalone Portable Wrapper for Spectral (OpenAPI & AsyncAPI Contract Linter)
# Zero Host Modification - Uses Repo-Local Portable Toolchain
# ==============================================================================
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
BUN="bun"
if [ -x "$REPO_ROOT/portables/bun/bin/bun" ]; then
    BUN="$REPO_ROOT/portables/bun/bin/bun"
elif command -v bun >/dev/null 2>&1; then
    BUN="bun"
fi
LOCAL_BIN="$REPO_ROOT/node_modules/.bin/spectral"

ARGS=("$@")
if [ "${ARGS[0]:-}" = "lint" ]; then
    ARGS=("${ARGS[@]:1}")
fi

if [ -f "$LOCAL_BIN" ]; then
    exec "$BUN" run "$LOCAL_BIN" lint --ruleset "$REPO_ROOT/.spectral.yaml" "${ARGS[@]}"
else
    SYS_SPECTRAL="$(which -a spectral 2>/dev/null | grep -v "$SCRIPT_DIR" | head -n 1 || true)"
    if [ -n "$SYS_SPECTRAL" ] && [ -x "$SYS_SPECTRAL" ]; then
        exec "$SYS_SPECTRAL" lint --ruleset "$REPO_ROOT/.spectral.yaml" "${ARGS[@]}"
    else
        echo "❌ [spectral] Local binary not found at $LOCAL_BIN. Run './run.sh setup' to install." >&2
        exit 1
    fi
fi
