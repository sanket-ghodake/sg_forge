#!/usr/bin/env bash
# ==============================================================================
# Standalone Portable Wrapper for CodeBurn (AI Token & Spend Tracker)
# Zero Host Modification - Enterprise Clean Architecture (2026 LTS)
# ==============================================================================
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

# Enterprise privacy & telemetry suppression
export DO_NOT_TRACK=1
export CODEBURN_TELEMETRY=0

LOCAL_CODEBURN="$WORKSPACE_ROOT/node_modules/.bin/codeburn"
SYS_CODEBURN="$(which -a codeburn 2>/dev/null | grep -v "portables/bin" | head -n 1 || true)"
PORTABLE_BUN="$WORKSPACE_ROOT/portables/bun/bin/bun"

if [ -f "$LOCAL_CODEBURN" ] && [ -x "$LOCAL_CODEBURN" ]; then
    exec "$LOCAL_CODEBURN" "$@"
elif [ -n "$SYS_CODEBURN" ] && [ -x "$SYS_CODEBURN" ]; then
    exec "$SYS_CODEBURN" "$@"
elif [ -x "$PORTABLE_BUN" ]; then
    exec "$PORTABLE_BUN" x --bun codeburn "$@"
elif command -v bun >/dev/null 2>&1; then
    exec bun x --bun codeburn "$@"
elif command -v npx >/dev/null 2>&1; then
    exec npx --yes codeburn "$@"
else
    echo "❌ [codeburn] Neither local codeburn, bun, nor npx was found." >&2
    exit 1
fi
