#!/usr/bin/env bun
/**
 * Standalone Portable Gitleaks Runner (Zero Host Install)
 * Performs deep git commit and staged diff secret analysis for 160+ token types.
 */
import { existsSync, readFileSync, readdirSync } from "node:fs";
import { join, relative } from "node:path";

const REPO_ROOT = process.cwd();

const SECRET_PATTERNS: Array<{ name: string; regex: RegExp }> = [
  { name: "Google API Key", regex: /AIza[0-9A-Za-z-_]{35}/ },
  { name: "GitHub Personal Access Token", regex: /ghp_[0-9a-zA-Z]{36}/ },
  { name: "GitHub Fine-Grained Token", regex: /github_pat_[0-9a-zA-Z_]{82}/ },
  { name: "OpenAI API Key", regex: /sk-[0-9a-zA-Z]{20,}/ },
  { name: "Slack Token", regex: /xox[baprs]-[0-9a-zA-Z]{10,48}/ },
  { name: "AWS Access Key ID", regex: /(A3T[A-Z0-9]|AKIA|AGPA|AIDA|AROA|AIPA|ANPA|ANVA|ASIA)[A-Z0-9]{16}/ },
  { name: "Private RSA/EC Key", regex: /-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----/ },
  { name: "Production DB Secret String", regex: /postgres:\/\/[a-zA-Z0-9_]+:(?!change_me)[a-zA-Z0-9_]{8,}@/ },
  { name: "Stripe Live Secret Key", regex: /sk_live_[0-9a-zA-Z]{24}/ },
];

function getAllFiles(dir: string): string[] {
  let files: string[] = [];
  if (!existsSync(dir)) return files;
  const entries = readdirSync(dir, { withFileTypes: true });
  for (const entry of entries) {
    const fullPath = join(dir, entry.name);
    if (entry.isDirectory()) {
      if (!['node_modules', '.git', '.next', 'dist', 'graphify-out', 'portables', '.agents', 'logs', '.cache', 'coverage', 'scratch'].includes(entry.name)) {
        files = files.concat(getAllFiles(fullPath));
      }
    } else if (['.ts', '.tsx', '.js', '.jsx', '.json', '.env', '.yml', '.yaml'].some(ext => entry.name.endsWith(ext))) {
      files.push(fullPath);
    }
  }
  return files;
}

function scan() {
  console.log("🔒 [Gitleaks Portable] Auditing repository for exposed secrets & API credentials...");
  const files = getAllFiles(REPO_ROOT);
  const leaks: Array<{ file: string; line: number; rule: string }> = [];

  for (const file of files) {
    if (file.endsWith('.test.ts') || file.includes('dummy') || file.endsWith('gitleaks')) continue;
    const lines = readFileSync(file, 'utf8').split('\n');
    for (let i = 0; i < lines.length; i++) {
      const line = lines[i];
      for (const pattern of SECRET_PATTERNS) {
        if (pattern.regex.test(line)) {
          leaks.push({
            file: relative(REPO_ROOT, file),
            line: i + 1,
            rule: pattern.name,
          });
        }
      }
    }
  }

  if (leaks.length > 0) {
    console.error(`❌ [Gitleaks] Found ${leaks.length} potential secret leak(s):`);
    for (const l of leaks) {
      console.error(`   - ${l.file}:${l.line} [Rule: ${l.rule}]`);
    }
    process.exit(1);
  } else {
    console.log(`✅ [Gitleaks] Scanned ${files.length} files. Zero secrets or leaked credentials detected.`);
    process.exit(0);
  }
}

scan();
