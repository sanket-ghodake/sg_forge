# ==============================================================================
# SG Forge - Git Submodules Manifest (2026 LTS)
# Maps autonomous micro-apps in forge-apps/* to independent repositories.
# ==============================================================================

[submodule "forge-apps/app-template"]
	path = forge-apps/app-template
	url = ./forge-apps/app-template
	branch = main

[submodule "forge-apps/telemetry"]
	path = forge-apps/telemetry
	url = ./forge-apps/telemetry
	branch = main

[submodule "forge-apps/code"]
	path = forge-apps/code
	url = ./forge-apps/code
	branch = main

