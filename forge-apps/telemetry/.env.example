# ==============================================================================
# Standalone Forge Micro-App Configuration: Telemetry Dashboard (2026 LTS)
# ==============================================================================

# Core Service Identity & Networking
PORT=8087
NODE_ENV=development
APP_NAME=telemetry
CONTAINER_PREFIX=ag

# Storage & Observability Paths (Defaults to ./data and ./logs relative to submodule)
DATA_DIR=
LOG_DIR=

# Authentication Redirect & Session Cookie (Optional)
# - Behind Caddy Gateway (Standard): Leave empty to use relative path '/auth/login'
# - Standalone Development (Direct Port): Set to 'http://localhost:3004' (or 'http://localhost:8080/auth')
AUTH_SERVICE_URL=
SESSION_COOKIE_NAME=forge_session

# Enterprise Branding & Identity
BRAND_NAME=SG Forge
BRAND_DOMAIN=forge.internal
