{
  "name": "@forge-apps/telemetry",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "test": "bun test",
    "verify": "bun run scripts/verify-gate.ts",
    "docs:dev": "bun --watch src/server.ts",
    "docs:coverage": "bun run scripts/verify-gate.ts",
    "backup": "bun run scripts/backup-db.ts",
    "compile": "bun build src/server.ts --target=bun --minify --sourcemap=none --outdir dist",
    "build": "docker build -f docker/Dockerfile -t forge-app-template .",
    "lint": "./run.sh lint",
    "deadcode": "./run.sh deadcode",
    "secrets": "./run.sh secrets",
    "semgrep": "./run.sh semgrep",
    "shellcheck": "./run.sh shellcheck",
    "complexity": "./run.sh complexity",
    "typecheck": "./run.sh typecheck",
    "trivy": "./run.sh trivy",
    "vuln": "./run.sh vuln",
    "sbom": "./run.sh sbom",
    "doctor": "./run.sh doctor",
    "clean": "./run.sh clean"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "latest"
  },
  "license": "Apache-2.0",
  "author": "Sanket Ghodake <sanketghodke03@gmail.com>"
}
