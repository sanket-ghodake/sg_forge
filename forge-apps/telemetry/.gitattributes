# ==============================================================================
# SG Forge Submodule - Git Attributes & Cross-Platform Line Endings (2026 LTS)
# ==============================================================================

# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Force LF on shell scripts and containers (prevents \r\n interpreter crashes)
*.sh text eol=lf
*.bash text eol=lf
Dockerfile* text eol=lf
docker-compose*.yml text eol=lf

# Force CRLF on Windows batch files
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.db binary
*.sqlite binary
*.png binary
*.jpg binary
*.ico binary
