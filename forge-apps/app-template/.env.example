# Standalone Forge Micro-App Configuration
PORT=8099
NODE_ENV=development
APP_NAME=template

# Local Storage Paths (Defaults to ./data and ./logs relative to submodule)
DATA_DIR=
LOG_DIR=

# Authentication & Session Verification
JWT_SECRET=dev-portable-secret-key-that-is-at-least-32-characters-long
AUTH_SERVICE_URL=http://localhost:3004
